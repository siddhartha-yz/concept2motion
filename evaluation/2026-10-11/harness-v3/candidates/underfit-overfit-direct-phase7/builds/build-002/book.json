      "code": "function draw({svg,width,height,progress,params,state,controls}){\n\nconst NS='http://www.w3.org/2000/svg';\nfunction el(key,tag,attrs,text,parent=svg){let e=svg.querySelector('[data-key=\"'+key+'\"]');if(!e){e=document.createElementNS(NS,tag);e.setAttribute('data-key',key);parent.appendChild(e);}for(const [k,v] of Object.entries(attrs))e.setAttribute(k,String(v));if(text!==undefined)e.textContent=text;return e;}\nfunction t(k,x,y,s,fill='#46545e',anchor='start',size=13){return el(k,'text',{x,y,fill,'text-anchor':anchor,'font-size':size,'font-family':'system-ui, sans-serif'},s);}\nfunction line(k,x1,y1,x2,y2,c,dash=''){return el(k,'line',{x1,y1,x2,y2,stroke:c,'stroke-width':1.3,'stroke-dasharray':dash});}\nconst ink='#243c4b',teal='#247a77',orange='#b36b32',grid='#e3e8e8';\n\nconst n=Number(params.n||6), left=45,right=width-26,top=110,bottom=height-55;\nconst X=e=>left+e/.5*(right-left),Y=p=>bottom-p/.55*(bottom-top);\nlet prob=Math.pow(.5,n),masses=[];\nfor(let k=0;k<=n;k++){if(k<=n/2)masses.push({error:k/n,p:prob*(k===n/2?1:2)});prob*= (n-k)/(k+1);}\nconst expected=masses.reduce((s,a)=>s+a.error*a.p,0);\nt('caption',left,18,'每次重新抽样，再选多数类',ink);\nt('train',left,43,'平均训练误差 '+expected.toFixed(3),orange);\nt('true',left,65,'总体误差 0.500',teal);\nt('prob',left,top-12,'概率',ink);\nfor(let i=0;i<3;i++){let p=i*.2;line('gy'+i,left,Y(p),right,Y(p),grid);t('yl'+i,left-8,Y(p)+4,p.toFixed(1),ink,'end',12);}\nfor(let i=0;i<3;i++){let e=i*.25;line('tick'+i,X(e),bottom,X(e),bottom+5,ink);t('xl'+i,X(e),bottom+22,e.toFixed(2),ink,'middle',12);}\nline('axis',left,bottom,right,bottom,ink);\nfor(let i=0;i<61;i++){const a=masses[i];el('stem'+i,'line',{x1:a?X(a.error):0,x2:a?X(a.error):0,y1:bottom,y2:a?Y(a.p):bottom,stroke:orange,'stroke-width':n===6?7:2,opacity:a?0.7:0});}\nt('sample',X(1/3),Y(.46875)-10,n===6?'1/3':'',orange,'middle',12);\nline('expected',X(expected),top,X(expected),bottom,orange,'4 4');\nline('gen',X(.5),top,X(.5),bottom,teal,'3 3');\nt('xname',(left+right)/2,height-9,'训练误差 = 少数类数 / n',ink,'middle');\nreturn {n,model:'从训练样本选择常量多数类；平票任选',condition:'独立公平硬币，无输入特征',distribution:masses,expectedTrainingError:expected,generalizationError:.5,probabilitySum:masses.reduce((s,a)=>s+a.p,0),note:'精确二项概率，非蒙特卡洛；总体误差为期望，不是测试样本误差'};\n}"
