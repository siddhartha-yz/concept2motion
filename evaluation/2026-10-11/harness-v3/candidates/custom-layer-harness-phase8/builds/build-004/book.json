    {
      "id": "linear-relu",
      "title": "同一输入，两个输出各算一遍",
      "afterAnchor": "custom-layer-019",
      "height": 360,
      "mobileHeight": 430,
      "interaction": "parameters",
      "params": [
        {
          "key": "first",
          "label": "输入 x₁",
          "min": -2,
          "max": 3,
          "step": 0.1,
          "value": 1
        },
        {
          "key": "bias",
          "label": "偏置 b₁",
          "min": -2,
          "max": 2,
          "step": 0.1,
          "value": 0.2
        }
      ],
      "state": {
        "output": 0
      },
      "summary": "用固定权重的 3→2 小例子：点选输出看求和，调输入或偏置看 ReLU 何时截成 0。权重未经训练。",
      "scene": {
        "type": "stack",
        "layout": {
          "weights": [
            4,
            1
          ],
          "gap": 8
        },
        "children": [
          {
            "id": "layer",
            "type": "dense-layer",
            "props": {
              "input": [
                [
                  {
                    "$param": "first"
                  },
                  2,
                  -1
                ]
              ],
              "weights": [
                [
                  1,
                  -2
                ],
                [
                  0.5,
                  1
                ],
                [
                  2,
                  -1
                ]
              ],
              "bias": [
                {
                  "$param": "bias"
                },
                0
