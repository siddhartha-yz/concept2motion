    {
      "id": "head-index",
      "afterAnchor": "multihead-attention-016",
      "title": "点一个编号，追踪拆头后的去向",
      "height": 360,
      "mobileHeight": 520,
      "interaction": "parameters",
      "state": {
        "element": 6
      },
      "summary": "B=2，N=2，H=2，d=2；蓝色为头0，橙色为头1。编号只用于追踪数值。右侧每块是合并后的一个批次行，列为头内坐标 d。",
      "code": "function draw(input) {\n const {board:b,width:w,state,controls}=input;\n const mobile=w<500, ink=VisualBook.palette.ink, muted=VisualBook.palette.muted;\n const colors=[VisualBook.palette.blue,VisualBook.palette.orange];\n const chosen=Number.isInteger(state.element)?state.element:6;\n const cell=mobile?30:36;\n const left=mobile?20:36, right=mobile?20:w/2+28;\n const yIn=42, yOut=mobile?242:42;\n b.text('in-title','投影后 X · (B,N,Hd)',left,18,{size:15,color:ink});\n b.text('out-title','拆头后 · (BH,N,d)',right,mobile?216:18,{size:15,color:ink});\n for(let batch=0;batch<2;batch++) {\n  const y=yIn+batch*(2*cell+24);\n  b.text('in-b-'+batch,'b'+batch,left,y-8,{size:13,color:muted});\n  for(let q=0;q<2;q++)for(let h=0;h<2;h++)for(let d=0;d<2;d++) {\n   const id=((batch*2+q)*2+h)*2+d, x=left+30+(h*2+d)*cell, yy=y+q*cell;\n   const node=b.rect('in-cell-'+id,x,yy,cell-3,cell-3,colors[h],{'fill-opacity':id===chosen?.7:.16,stroke:id===chosen?ink:'none','stroke-width':2});\n   b.text('in-value-'+id,String(id),x+(cell-3)/2,yy+cell/2+4,{size:14,anchor:'middle',color:ink});\n   b.selectable(node,{label:'追踪元素 '+id,selected:id===chosen,onSelect:()=>controls.setState('element',id)});\n  }\n  for(let q=0;q<2;q++)b.text('in-q-'+batch+'-'+q,'q'+q,left,y+q*cell+cell/2+4,{size:12,color:muted});\n }\n for(let batch=0;batch<2;batch++)for(let h=0;h<2;h++) {\n  const x=right+h*(2*cell+50)+30, y=yOut+batch*(2*cell+34);\n  b.text('out-group-'+batch+h,'r'+(batch*2+h)+' = b'+batch+'·头'+h,x,y-8,{size:12,color:muted});\n  for(let q=0;q<2;q++)for(let d=0;d<2;d++) {\n   const id=((batch*2+q)*2+h)*2+d, xx=x+d*cell, yy=y+q*cell;\n   const node=b.rect('out-cell-'+id,xx,yy,cell-3,cell-3,colors[h],{'fill-opacity':id===chosen?.7:.16,stroke:id===chosen?ink:'none','stroke-width':2});\n   b.text('out-value-'+id,String(id),xx+(cell-3)/2,yy+cell/2+4,{size:14,anchor:'middle',color:ink});\n\n  }\n  for(let q=0;q<2;q++)b.text('out-q-'+batch+h+q,'q'+q,x-25,y+q*cell+cell/2+4,{size:12,color:muted});\n }\n const batch=Math.floor(chosen/8),q=Math.floor(chosen/4)%2,h=Math.floor(chosen/2)%2,d=chosen%2;\n for(let d=0;d<2;d++)for(let h=0;h<2;h++)b.text('d-axis-'+h+d,'d'+d,right+30+h*(2*cell+50)+d*cell+cell/2,yOut+2*cell+(2*cell+34)+15,{size:12,color:muted,anchor:'middle'});\n const base=mobile?454:290;\n b.text('map-title','元素 '+chosen+' 的索引',left,base,{size:14,color:ink});\n b.text('mapping','['+batch+','+q+','+(h*2+d)+']  →  ['+(batch*2+h)+','+q+','+d+']',left,base+26,{size:17,color:ink});\n b.text('inverse','逆操作：⌊r/H⌋ 还原批次，r mod H 还原头',left,base+52,{size:mobile?12:14,color:muted});\n return {inputShape:[2,2,4],splitShape:[2,2,2,2],permutedShape:[2,2,2,2],outputShape:[4,2,2],selected:chosen,inputIndex:[batch,q,h*2+d],outputIndex:[batch*2+h,q,d],mapping:'X[b,q,2h+d] = Y[2b+h,q,d]',values:Array.from({length:16},(_,i)=>i)};\n}"
    }
  ],
  "annotations": [
    {
      "id": "note-head-divisibility",
      "afterAnchor": "multihead-attention-013",
      "kind": "condition",
      "text": "这份实现要求 num_hiddens 能被 num_heads 整除；每个头的维数为 d=num_hiddens/num_heads。拆头是在学到的线性投影之后进行，不能把它等同于直接切分原始输入特征。",
      "formula": "p_o \\bmod h=0"
    },
    {
      "id": "note-ones-uniform",
      "afterAnchor": "multihead-attention-019",
      "kind": "clarification",
      "text": "这个全 1 输入只检查输出形状。在 eval 模式下，同一头中的有效键完全相同，分数也相同：两个样本分别在 3 个、2 个有效键上均匀分配权重，屏蔽位置为 0。因此本例不能展示不同头关注不同位置，也不能据此判断头的重要性。",
      "formula": "\\alpha_{bj}=\\begin{cases}1/L_b,&j<L_b\\\\0,&j\\ge L_b\\end{cases},\\quad L_b\\in\\{3,2\\}"
    }
  ]
