      "type": "code",
      "depth": null,
      "line": 62,
      "raw": "```python\nn_train = 50  # 训练样本数\nx_train, _ = torch.sort(d2l.rand(n_train) * 5)   # 排序后的训练样本\n```",
      "math": {
