      "type": "paragraph",
      "depth": null,
      "line": 397,
      "raw": "$$P(\\mathbf y \\mid \\mathbf X) = \\prod_{i=1}^{n} p(y^{(i)}|\\mathbf{x}^{(i)}).$$",
      "math": {
        "expected": 1,
        "rendered": 1,
        "errors": 0,
        "pending": 0
