    },
    {
      "id": "linear-regression-029",
      "sha256": "100aeacb16799e878583b00c600001e389eaf9f42af152d8b0e9729345abc4a9",
      "type": "paragraph",
      "depth": null,
      "line": 123,
      "raw": "$$L(\\mathbf{w}, b) =\\frac{1}{n}\\sum_{i=1}^n l^{(i)}(\\mathbf{w}, b) =\\frac{1}{n} \\sum_{i=1}^n \\frac{1}{2}\\left(\\mathbf{w}^\\top \\mathbf{x}^{(i)} + b - y^{(i)}\\right)^2.$$",
      "math": {
        "expected": 1,
