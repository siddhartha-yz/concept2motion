      }
    },
    {
      "id": "calculus-022",
      "sha256": "be724730996dd7a79bb9a30390168c8443fb6d10c98ed09f946fa64d78633754",
      "type": "paragraph",
      "depth": null,
      "line": 121,
      "raw": "*常数相乘法则*\n$$\\frac{d}{dx} [Cf(x)] = C \\frac{d}{dx} f(x),$$",
      "math": {
        "expected": 1,
