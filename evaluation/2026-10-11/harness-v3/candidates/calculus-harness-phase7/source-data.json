      "type": "paragraph",
      "depth": null,
      "line": 126,
      "raw": "$$\\frac{d}{dx} [f(x) + g(x)] = \\frac{d}{dx} f(x) + \\frac{d}{dx} g(x),$$",
      "math": {
        "expected": 1,
