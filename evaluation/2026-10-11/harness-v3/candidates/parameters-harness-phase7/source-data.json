      "type": "code",
      "depth": null,
      "line": 633,
      "raw": "```python\n# 我们需要给共享层一个名称，以便可以引用它的参数\nshared = nn.Linear(8, 8)\nnet = nn.Sequential(nn.Linear(4, 8), nn.ReLU(),\n                    shared, nn.ReLU(),\n                    shared, nn.ReLU(),\n                    nn.Linear(8, 1))\nnet(X)\n# 检查参数是否相同\nprint(net[2].weight.data[0] == net[4].weight.data[0])\nnet[2].weight.data[0, 0] = 100\n# 确保它们实际上是同一个对象，而不只是有相同的值\nprint(net[2].weight.data[0] == net[4].weight.data[0])\n```",
      "math": {
        "expected": 0,
        "rendered": 0,
        "errors": 0,
