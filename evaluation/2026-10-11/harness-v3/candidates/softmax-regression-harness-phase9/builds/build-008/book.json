  "annotations": [
    {
      "id": "label-order",
      "afterAnchor": "softmax-regression-012",
      "kind": "clarification",
      "text": "整数标签与独热向量采用了不同的示例顺序；编码时须固定映射。本页图解统一按“猫、鸡、狗”排列。"
    },
    {
      "id": "calibration",
      "afterAnchor": "softmax-regression-025",
      "kind": "clarification",
      "text": "softmax保证输出构成概率分布，但不保证校准。校准需要在一批有真实标签的样本上比较预测概率与发生频率。"
    },
    {
      "id": "weight-orientation",
      "afterAnchor": "softmax-regression-034",
      "kind": "clarification",
      "text": "单样本以列向量表示时，权重为 q×d；这里把样本堆成行，权重对应转置为 d×q。两处是同一个模型的不同记法。",
      "formula": "W_{\\mathrm{batch}}=W_{\\mathrm{single}}^\\top"
    },
    {
      "id": "independence",
      "afterAnchor": "softmax-regression-039",
      "kind": "condition",
      "text": "此乘积分解假设：给定输入与模型参数后，各样本的标签条件独立。若标签仍相互依赖，联合似然不能直接这样分解。"
    },
    {
      "id": "units",
      "afterAnchor": "softmax-regression-068",
      "kind": "clarification",
      "text": "本节采用自然对数，损失与交叉熵的单位是 nat；换算为 bit 需除以 ln 2。交叉熵包含真实分布自身的熵，不是对称距离。",
      "formula": "H(P,Q)=H(P)+D_{\\mathrm{KL}}(P\\|Q)"
    }
  ]
}
