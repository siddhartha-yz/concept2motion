{
  "figures": [
    {
      "title": "一类分数改变，三类概率联动",
      "height": 300,
      "mobileHeight": 430,
      "params": [
        {
          "key": "score",
          "label": "第2类分数",
          "min": -3,
          "max": 3,
          "step": 0.1,
          "value": 0
        },
        {
          "key": "shift",
          "label": "共同平移",
          "min": -5,
          "max": 5,
          "step": 0.1,
          "value": 0
        }
      ],
      "state": {
        "selected": 1
      },
      "interaction": "parameters",
      "scene": {
        "type": "compose",
        "calculations": [
          {
            "id": "scores",
            "operation": "dense",
            "inputs": {
              "input": [
                [
                  {
                    "$param": "shift"
                  }
                ]
              ],
              "weights": [
                [
                  1,
                  1,
                  1
                ]
              ],
              "bias": [
                -1,
                {
                  "$param": "score"
                },
                1
              ]
            }
          },
          {
            "id": "weights",
            "operation": "softmax",
            "inputs": {
              "scores": {
                "$result": "scores.output.0"
              }
            }
          }
        ],
        "visual": {
          "type": "columns",
          "layout": {
            "minColumnWidth": 290,
            "gap": 18
          },
          "children": [
            {
              "id": "score-view",
              "type": "aligned-points",
              "props": {
                "title": "分数 o（无单位）",
                "rows": [
                  {
                    "label": "三类分数",
                    "values": {
                      "$result": "scores.output.0"
                    }
                  }
                ],
                "domain": [
                  -8,
                  8
                ],
                "selected": {
                  "$state": "selected"
                },
                "stateKey": "selected",
                "connect": false,
                "statistics": false,
                "pointColors": [
                  "blue",
                  "orange",
                  "green"
                ],
                "itemLabels": [
                  "猫",
                  "鸡",
                  "狗"
                ]
              }
            },
            {
              "id": "probabilities",
              "type": "aligned-points",
              "props": {
                "title": "概率 p（总和为 1）",
                "rows": [
                  {
                    "label": "三类概率",
                    "values": {
                      "$result": "weights.weights"
                    }
                  }
                ],
                "domain": [
                  0,
                  1
                ],
                "selected": {
                  "$state": "selected"
                },
                "stateKey": "selected",
                "connect": false,
                "statistics": false,
                "pointColors": [
                  "blue",
                  "orange",
                  "green"
                ],
                "itemLabels": [
                  "猫",
                  "鸡",
                  "狗"
                ]
              }
            }
          ]
        }
      },
      "summary": "先调鸡的分数，再试共同平移。三类分数手设；颜色始终对应猫、鸡、狗。",
      "id": "class-competition",
      "afterAnchor": "softmax-regression-029",
      "designRef": {
        "id": "softmax-competition",
        "catalogSha256": "5a26cd09176c731344bfaf93dc5bc8f7077f3d8fdb4a3243f398c6dd9aade6aa",
        "overrides": [
          {
            "path": "/scene/visual/children/0/props/itemLabels",
            "value": [
              "猫",
              "鸡",
              "狗"
            ]
          },
          {
            "path": "/scene/visual/children/1/props/itemLabels",
            "value": [
              "猫",
              "鸡",
              "狗"
            ]
          },
          {
            "path": "/scene/visual/children/0/props/title",
            "value": "分数 o（无单位）"
          },
          {
            "path": "/scene/visual/children/1/props/title",
            "value": "概率 p（总和为 1）"
          }
        ]
      }
    },
    {
      "title": "减去梯度，正确类别的概率怎样变化？",
      "height": 330,
      "mobileHeight": 560,
      "params": [
        {
          "key": "target",
          "label": "正确类别",
          "kind": "select",
          "options": [
            {
              "label": "第1类",
              "value": 0
            },
            {
              "label": "第2类",
              "value": 1
            },
            {
              "label": "第3类",
              "value": 2
            }
          ],
          "value": 1
        },
        {
          "key": "eta",
          "label": "步长",
          "min": 0,
          "max": 3,
          "step": 0.1,
          "value": 1
        }
      ],
      "state": {},
      "interaction": "parameters",
      "scene": {
        "type": "compose",
        "calculations": [
          {
            "id": "before",
            "operation": "softmax-loss",
            "inputs": {
              "logits": [
                [
                  -1,
                  0,
                  1
                ]
              ],
              "labels": [
                {
                  "$param": "target"
                }
              ]
            }
          },
          {
            "id": "step",
            "operation": "gradient-step",
            "inputs": {
              "values": {
                "$result": "before.logits"
              },
              "gradient": {
                "$result": "before.gradient"
              },
              "eta": {
                "$param": "eta"
              }
            }
          },
          {
            "id": "after",
            "operation": "softmax-loss",
            "inputs": {
              "logits": {
                "$result": "step.after"
              },
              "labels": {
                "$result": "before.labels"
              }
            }
          }
        ],
        "visual": {
          "type": "columns",
          "layout": {
            "minColumnWidth": 290,
            "weights": [
              2,
              1.5
            ],
            "gap": 18
          },
          "children": [
            {
              "id": "probabilities",
              "type": "aligned-points",
              "props": {
                "rows": [
                  {
                    "label": "更新前概率",
                    "values": {
                      "$result": "before.probabilities.0"
                    }
                  },
                  {
                    "label": "更新后概率",
                    "values": {
                      "$result": "after.probabilities.0"
                    }
                  }
                ],
                "domain": [
                  0,
                  1
                ],
                "selected": {
                  "$param": "target"
                },
                "connect": true,
                "statistics": false,
                "pointColors": [
                  "blue",
                  "orange",
                  "green"
                ],
                "itemLabels": [
                  "猫",
                  "鸡",
                  "狗"
                ]
              }
            },
            {
              "id": "readout",
              "type": "readout",
              "props": {
                "items": [
                  {
                    "label": "梯度（猫 / 鸡 / 狗）",
                    "value": {
                      "$result": "before.gradient.0"
                    },
                    "color": "ink"
                  },
                  {
                    "label": "更新前损失 · nat",
                    "value": {
                      "$result": "before.loss"
                    },
                    "color": "blue"
                  },
                  {
                    "label": "更新后损失 · nat",
                    "value": {
                      "$result": "after.loss"
                    },
                    "color": "orange"
                  }
                ]
              }
            }
          ]
        }
      },
      "summary": "固定初始分数 (−1, 0, 1)，每次独立做一步 logit 更新；不是网络权重训练。步长为 0 可对照起点。",
      "id": "loss-step",
      "afterAnchor": "softmax-regression-050",
      "designRef": {
        "id": "softmax-gradient-step",
        "catalogSha256": "5a26cd09176c731344bfaf93dc5bc8f7077f3d8fdb4a3243f398c6dd9aade6aa",
        "overrides": [
          {
            "path": "/scene/visual/children/0/props/itemLabels",
            "value": [
              "猫",
              "鸡",
              "狗"
            ]
          },
          {
            "path": "/scene/visual/children/1/props/items",
            "value": [
              {
                "label": "梯度（猫 / 鸡 / 狗）",
                "value": {
                  "$result": "before.gradient.0"
                },
                "color": "ink"
              },
              {
                "label": "更新前损失 · nat",
                "value": {
                  "$result": "before.loss"
                },
                "color": "blue"
              },
              {
                "label": "更新后损失 · nat",
                "value": {
                  "$result": "after.loss"
                },
                "color": "orange"
              }
            ]
          }
        ]
      }
    }
  ]
}
