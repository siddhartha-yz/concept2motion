    {
      "id": "softmax-regression-059",
      "sha256": "381956e07b17d05597ee5fa359e5d26cb3a21b562b6efa6eae5f7e74251fbfdf",
      "type": "heading",
      "depth": 3,
      "line": 255,
      "raw": "### 信息量",
      "math": {
        "expected": 0,
        "rendered": 0,
        "errors": 0,
