    {
      "id": "softmax-regression-043",
      "sha256": "a4d50019ebb263a5229d951de0d0ae3b09a5f0f6e0a712371039e49246ca2f47",
      "type": "paragraph",
      "depth": null,
      "line": 185,
      "raw": "$$ l(\\mathbf{y}, \\hat{\\mathbf{y}}) = - \\sum_{j=1}^q y_j \\log \\hat{y}_j. $$",
      "math": {
