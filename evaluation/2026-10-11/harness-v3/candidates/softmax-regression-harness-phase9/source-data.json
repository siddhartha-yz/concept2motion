    {
      "id": "softmax-regression-047",
      "sha256": "f096696820ed5a0d485756357ba1f50459bdbcde994368463dd67148af2eb2a6",
      "type": "math",
      "depth": null,
      "line": 205,
      "raw": "$$\n\\begin{aligned}\nl(\\mathbf{y}, \\hat{\\mathbf{y}}) &=  - \\sum_{j=1}^q y_j \\log \\frac{\\exp(o_j)}{\\sum_{k=1}^q \\exp(o_k)} \\\\\n&= \\sum_{j=1}^q y_j \\log \\sum_{k=1}^q \\exp(o_k) - \\sum_{j=1}^q y_j o_j\\\\\n&= \\log \\sum_{k=1}^q \\exp(o_k) - \\sum_{j=1}^q y_j o_j.\n\\end{aligned}\n$$",
      "math": {
        "expected": 1,
        "rendered": 1,
        "errors": 0,
        "pending": 0
      }
    },
    {
      "id": "softmax-regression-048",
